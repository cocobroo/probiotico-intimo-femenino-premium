<style>
:root {
      --cream: #fffaf7;
      --shell: #fff0f4;
      --rose-soft: #f7c2cf;
      --rose: #e7547a;
      --berry: #a81442;
      --wine: #35121f;
      --ink: #21161b;
      --muted: #755d66;
      --line: rgba(168, 20, 66, 0.14);
      --white: #ffffff;
      --shadow: 0 22px 64px rgba(168, 20, 66, 0.14);
      --radius: 22px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: "Poppins", sans-serif;
      color: var(--ink);
      background: var(--cream);
      letter-spacing: 0;
      text-align: center;
      padding-bottom: 4.8rem;
    }

    img {
      display: block;
      max-width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    .topbar {
      background: var(--wine);
      color: var(--white);
      padding: 0.68rem 1rem;
      text-align: center;
      font-size: 0.78rem;
      font-weight: 700;
    }

    .nav {
      position: sticky;
      top: 0;
      z-index: 30;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1rem;
      padding: 0.9rem clamp(1rem, 4vw, 4.5rem);
      border-bottom: 1px solid var(--line);
      background: rgba(255, 250, 247, 0.86);
      backdrop-filter: blur(18px);
    }

    .cyber-strip {
      display: grid;
      place-items: center;
      gap: 0.35rem;
      padding: 0.72rem 1rem;
      background: linear-gradient(90deg, var(--berry), var(--rose), var(--berry));
      color: var(--white);
      text-align: center;
      font-size: 0.78rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      box-shadow: 0 12px 32px rgba(168, 20, 66, 0.22);
    }

    .cyber-strip small {
      display: block;
      color: rgba(255, 255, 255, 0.86);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0;
      text-transform: none;
    }

    .fomo-shelf {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 0.85rem 1rem;
      background: var(--white);
      border-bottom: 1px solid var(--line);
    }

    .fomo-chip {
      display: grid;
      justify-items: center;
      gap: 0.12rem;
      min-height: 3.4rem;
      padding: 0.7rem 0.85rem;
      border: 1px solid rgba(168, 20, 66, 0.16);
      border-radius: 18px;
      background: linear-gradient(180deg, var(--shell), var(--white));
      color: var(--wine);
      box-shadow: 0 12px 30px rgba(168, 20, 66, 0.08);
      text-align: center;
    }

    .fomo-chip strong {
      color: var(--berry);
      font-size: 0.88rem;
      font-weight: 900;
      line-height: 1.2;
    }

    .fomo-chip span {
      color: var(--muted);
      font-size: 0.74rem;
      font-weight: 800;
      line-height: 1.3;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.72rem;
      min-width: 0;
      color: var(--wine);
      font-weight: 800;
      line-height: 0.95;
      letter-spacing: 0;
      text-align: center;
    }

    .brand-avatar {
      width: 3rem;
      height: 3rem;
      flex: 0 0 auto;
      border-radius: 999px;
      object-fit: cover;
      background: var(--white);
      box-shadow: 0 12px 28px rgba(168, 20, 66, 0.16);
    }

    .brand-copy {
      display: grid;
      justify-items: center;
      gap: 0.2rem;
      overflow-wrap: anywhere;
    }

    .logo small {
      display: block;
      color: var(--muted);
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0.88rem 1.35rem;
      border: 0;
      border-radius: 999px;
      background: var(--berry);
      color: var(--white);
      font: inherit;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 18px 42px rgba(168, 20, 66, 0.22);
      transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
      white-space: nowrap;
    }

    .btn:hover {
      transform: translateY(-2px);
      background: var(--wine);
      box-shadow: 0 24px 52px rgba(53, 18, 31, 0.25);
    }

    .buy-form {
      display: inline-flex;
      justify-content: center;
      margin: 0;
    }

    .buy-form .btn {
      width: 100%;
    }

    .buy-form.is-hidden {
      display: none;
    }

    .btn-light {
      background: var(--white);
      color: var(--berry);
      box-shadow: 0 18px 42px rgba(53, 18, 31, 0.16);
    }

    .section {
      padding: clamp(3.4rem, 8vw, 6.2rem) clamp(1rem, 4vw, 4.5rem);
    }

    .wrap {
      width: min(1180px, 100%);
      margin: 0 auto;
      text-align: center;
    }

    .hero {
      overflow: hidden;
      padding: clamp(2.4rem, 6vw, 5rem) clamp(1rem, 4vw, 4.5rem) clamp(3.4rem, 8vw, 7rem);
      background:
        linear-gradient(120deg, rgba(255, 250, 247, 0.98), rgba(255, 240, 244, 0.96)),
        var(--cream);
    }

    .hero-grid,
    .lifestyle-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2rem, 6vw, 5rem);
      align-items: center;
      justify-content: center;
      justify-items: center;
    }

    .eyebrow {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      gap: 0.55rem;
      margin: 0 0 1rem;
      padding: 0.46rem 0.86rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--berry);
      background: rgba(255, 255, 255, 0.72);
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-left: auto;
      margin-right: auto;
    }

    .eyebrow::before {
      content: "";
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 999px;
      background: var(--rose);
    }

    h1,
    h2,
    h3,
    p {
      margin-top: 0;
    }

    h1 {
      max-width: 14ch;
      margin-bottom: 1rem;
      margin-left: auto;
      margin-right: auto;
      color: var(--wine);
      font-size: clamp(2.6rem, 11vw, 5.8rem);
      line-height: 0.94;
      letter-spacing: 0;
    }

    h2 {
      margin-bottom: 0.8rem;
      color: var(--wine);
      font-size: clamp(2rem, 6vw, 3.75rem);
      line-height: 1.02;
      letter-spacing: 0;
    }

    h3 {
      margin-bottom: 0.55rem;
      color: var(--wine);
      font-size: 1.08rem;
      line-height: 1.25;
    }

    .lead {
      max-width: 42rem;
      margin-bottom: 1.45rem;
      margin-left: auto;
      margin-right: auto;
      color: var(--muted);
      font-size: clamp(1rem, 2.2vw, 1.18rem);
      line-height: 1.75;
    }

    .price-row {
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: 0.65rem;
      margin-bottom: 1.3rem;
      color: var(--wine);
      font-weight: 800;
    }

    .price-row strong {
      font-size: clamp(2rem, 7vw, 3.7rem);
      line-height: 1;
    }

    .price-row del {
      color: var(--muted);
      font-size: 1rem;
      font-weight: 700;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.8rem;
      align-items: center;
    }

    .cyber-countdown {
      display: grid;
      justify-items: center;
      gap: 0.8rem;
      width: min(520px, 100%);
      margin: 0 auto 1.15rem;
      padding: 1rem;
      border: 1px solid rgba(168, 20, 66, 0.18);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 16px 42px rgba(168, 20, 66, 0.1);
    }

    .cyber-countdown strong {
      color: var(--berry);
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .countdown-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.55rem;
      width: 100%;
    }

    .time-box {
      display: grid;
      place-items: center;
      gap: 0.18rem;
      min-height: 4rem;
      border-radius: 18px;
      background: var(--wine);
      color: var(--white);
      font-weight: 900;
    }

    .time-box span {
      font-size: 1.35rem;
      line-height: 1;
    }

    .time-box small {
      color: rgba(255, 255, 255, 0.76);
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .fomo-line {
      width: min(620px, 100%);
      margin: 1rem auto 0;
      color: var(--berry);
      font-size: 0.9rem;
      font-weight: 900;
      line-height: 1.45;
    }

    .hero-card {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.78);
      border-radius: 32px;
      background: var(--white);
      box-shadow: var(--shadow);
    }

    .hero-card img {
      width: 100%;
      min-height: 360px;
      object-fit: cover;
    }

    .badges {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 1.45rem;
      width: min(100%, 760px);
      margin-left: auto;
      margin-right: auto;
    }

    .badge,
    .payment,
    .footer-link {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
    }

    .badge {
      min-height: 3.2rem;
      padding: 0.84rem 1rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.8);
      color: var(--wine);
      font-size: 0.9rem;
      font-weight: 800;
      box-shadow: 0 12px 28px rgba(168, 20, 66, 0.08);
    }

    .sale-tag {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2rem;
      padding: 0.38rem 0.76rem;
      border-radius: 999px;
      background: rgba(22, 128, 58, 0.12);
      color: #126b31;
      font-size: 0.76rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .icon {
      width: 1.1rem;
      height: 1.1rem;
      flex: 0 0 auto;
      stroke: currentColor;
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .social-proof {
      padding: 1rem clamp(1rem, 4vw, 4.5rem);
      border-block: 1px solid var(--line);
      background: var(--white);
      color: var(--wine);
      text-align: center;
      font-weight: 800;
    }

    .social-proof .btn {
      margin-top: 0.9rem;
      min-height: 2.65rem;
      padding: 0.7rem 1rem;
      font-size: 0.84rem;
    }

    .stars {
      color: #b77800;
      letter-spacing: 0;
    }

    .section-heading {
      max-width: 700px;
      margin-bottom: 2rem;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    .section-heading p,
    .benefit p,
    .step p,
    .testimonial p,
    .story p,
    .faq-panel,
    .lifestyle-copy p {
      color: var(--muted);
      line-height: 1.7;
    }

    .lifestyle-image {
      overflow: hidden;
      border-radius: 30px;
      box-shadow: var(--shadow);
      background: var(--shell);
    }

    .lifestyle-image img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      transition: transform 450ms ease;
    }

    .lifestyle-image:hover img {
      transform: scale(1.025);
    }

    .product-showcase {
      background: var(--cream);
    }

    .product-panel {
      display: grid;
      justify-items: center;
      gap: 1rem;
      width: min(900px, 100%);
      margin: 0 auto;
      padding: clamp(1.25rem, 5vw, 2.6rem);
      border: 1px solid var(--line);
      border-radius: 30px;
      background: rgba(255, 255, 255, 0.9);
      box-shadow: var(--shadow);
      text-align: center;
    }

    .product-image {
      width: min(420px, 100%);
      margin: 0;
      padding: clamp(0.85rem, 3vw, 1.3rem);
      border-radius: 28px;
      background: linear-gradient(180deg, var(--shell), var(--white));
    }

    .product-image img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: contain;
    }

    .product-description {
      max-width: 640px;
      margin: 0;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.75;
    }

    .product-details {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.7rem;
      width: min(720px, 100%);
      margin: 0.35rem auto 0;
    }

    .detail-pill {
      display: grid;
      justify-items: center;
      gap: 0.2rem;
      padding: 0.9rem;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: var(--cream);
      color: var(--muted);
      font-size: 0.86rem;
      line-height: 1.45;
    }

    .detail-pill strong {
      color: var(--wine);
      font-size: 0.95rem;
    }

    .product-price {
      width: min(360px, 100%);
      margin-top: 0.35rem;
    }

    .ingredient-list {
      display: grid;
      gap: 0.75rem;
      width: min(760px, 100%);
      margin: 1.4rem auto 0;
      padding: 0;
      list-style: none;
    }

    .ingredient-list li {
      padding: 0.95rem 1rem;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.82);
      color: var(--wine);
      font-weight: 700;
      line-height: 1.55;
      text-align: center;
    }

    .support-note {
      max-width: 680px;
      margin: 1rem auto 0;
      color: var(--muted);
      font-size: 0.82rem;
      line-height: 1.6;
    }

    .benefits {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .benefit,
    .step,
    .testimonial,
    .faq-item {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 16px 42px rgba(53, 18, 31, 0.07);
    }

    .benefit {
      padding: 1.35rem;
    }

    .cta-strip {
      display: grid;
      place-items: center;
      gap: 0.75rem;
      width: min(740px, 100%);
      margin: 2rem auto 0;
      padding: 1.2rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 16px 42px rgba(53, 18, 31, 0.07);
    }

    .cta-strip p {
      margin: 0;
      color: var(--muted);
      line-height: 1.6;
    }

    .pricing {
      background:
        linear-gradient(180deg, rgba(255, 240, 244, 0.82), rgba(255, 250, 247, 0.95)),
        var(--shell);
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      align-items: center;
      width: min(1120px, 100%);
      margin: 0 auto;
    }

    .price-card {
      position: relative;
      display: grid;
      justify-items: center;
      gap: 0.72rem;
      padding: 1.45rem;
      border: 1px solid var(--line);
      border-radius: 28px;
      background: var(--white);
      box-shadow: 0 16px 42px rgba(53, 18, 31, 0.08);
    }

    .price-card.featured {
      border: 2px solid var(--berry);
      box-shadow: 0 24px 64px rgba(168, 20, 66, 0.18);
    }

    .popular-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2rem;
      padding: 0.4rem 0.78rem;
      border-radius: 999px;
      background: var(--berry);
      color: var(--white);
      font-size: 0.74rem;
      font-weight: 800;
      letter-spacing: 0.08em;
    }

    .cyber-badge {
      background: linear-gradient(90deg, var(--wine), var(--berry));
    }

    .pack-title {
      color: var(--wine);
      font-size: 1.2rem;
      font-weight: 800;
    }

    .price-old {
      color: var(--muted);
      font-size: 0.94rem;
      text-decoration: line-through;
    }

    .price-real {
      color: var(--wine);
      font-size: clamp(2.15rem, 9vw, 3.25rem);
      font-weight: 800;
      line-height: 1;
    }

    .saving {
      color: #16803a;
      font-size: 0.92rem;
      font-weight: 800;
    }

    .unit-price,
    .pack-note,
    .secure-line {
      color: var(--muted);
      font-size: 0.82rem;
      line-height: 1.45;
    }

    .pack-note {
      max-width: 15rem;
      font-weight: 700;
    }

    .secure-line {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2rem;
      margin-top: 0.2rem;
      padding: 0.35rem 0.72rem;
      border-radius: 999px;
      background: var(--shell);
      color: var(--berry);
      font-weight: 800;
    }

    .stock-note {
      color: var(--berry);
      font-size: 0.78rem;
      font-weight: 900;
      line-height: 1.35;
    }

    .benefit-icon {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      margin: 0 auto 1rem;
      border-radius: 999px;
      background: var(--shell);
      color: var(--berry);
    }

    .steps {
      position: relative;
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .step {
      position: relative;
      padding: 1.4rem;
    }

    .step-number {
      display: inline-grid;
      place-items: center;
      width: 2.65rem;
      height: 2.65rem;
      margin: 0 auto 1rem;
      border-radius: 999px;
      background: var(--wine);
      color: var(--white);
      font-weight: 800;
    }

    .gallery {
      background: var(--shell);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .gallery-item {
      overflow: hidden;
      min-height: 280px;
      border-radius: 30px;
      background: var(--white);
      box-shadow: var(--shadow);
    }

    .gallery-item img {
      width: 100%;
      height: 100%;
      min-height: 280px;
      object-fit: cover;
      filter: brightness(0.98);
      transition: transform 420ms ease, filter 420ms ease;
    }

    .gallery-item:hover img {
      transform: scale(1.04);
      filter: brightness(1.04);
    }

    .testimonials {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .testimonial {
      padding: 1.35rem;
    }

    .avatar {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      margin: 0 auto 1rem;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--rose), var(--berry));
      color: var(--white);
      font-weight: 800;
    }

    .person {
      margin-top: 1rem;
      color: var(--wine);
      font-weight: 800;
    }

    .city {
      display: block;
      color: var(--muted);
      font-size: 0.86rem;
      font-weight: 600;
    }

    .story {
      max-width: 880px;
      margin: 0 auto;
      text-align: center;
    }

    .story p {
      font-size: clamp(1.05rem, 2.5vw, 1.35rem);
    }

    .faq-list {
      display: grid;
      gap: 0.85rem;
    }

    .faq-question {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      padding: 1.1rem 1.2rem;
      border: 0;
      background: transparent;
      color: var(--wine);
      font: inherit;
      font-weight: 800;
      text-align: center;
      cursor: pointer;
    }

    .faq-mark {
      width: 2rem;
      height: 2rem;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      border-radius: 999px;
      background: var(--shell);
      color: var(--berry);
      transition: transform 220ms ease;
    }

    .faq-question[aria-expanded="true"] .faq-mark {
      transform: rotate(45deg);
    }

    .faq-panel {
      max-height: 0;
      overflow: hidden;
      padding: 0 1.2rem;
      transition: max-height 260ms ease, padding-bottom 260ms ease;
    }

    .faq-panel.open {
      max-height: 220px;
      padding-bottom: 1.2rem;
    }

    .final-cta {
      overflow: hidden;
      background:
        linear-gradient(135deg, rgba(168, 20, 66, 0.96), rgba(53, 18, 31, 0.98)),
        var(--berry);
      color: var(--white);
      text-align: center;
    }

    .final-cta h2,
    .final-cta p {
      color: var(--white);
    }

    .final-cta p {
      max-width: 680px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.7;
    }

    .stock,
    .timer {
      display: inline-flex;
      margin: 0.55rem 0.35rem 1.25rem;
      padding: 0.58rem 0.9rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.15);
      font-size: 0.9rem;
      font-weight: 800;
    }

    .mobile-cyber-cta {
      position: fixed;
      left: 0.75rem;
      right: 0.75rem;
